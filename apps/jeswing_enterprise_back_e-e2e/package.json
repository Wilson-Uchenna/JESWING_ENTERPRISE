{
  "name": "@jeswing-enterprise/jeswing_enterprise_back_e-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@jeswing-enterprise/jeswing_enterprise_back_e"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/jeswing_enterprise_back_e-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@jeswing-enterprise/jeswing_enterprise_back_e:build",
          "@jeswing-enterprise/jeswing_enterprise_back_e:serve"
        ]
      }
    }
  }
}
